# Environment configuration for Coder-lite Provision System

# Server configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Port allocation
START_PORT=13001
MAX_PORT=65535

# Coder-lite paths
CODER_LITE_PATH=/opt/coder-lite

# Database configuration (for future use)
DATABASE_URL=postgresql://coder:password@localhost/coder_lite

# Security
WEBHOOK_SECRET=your_webhook_secret_here
JWT_SECRET=your_jwt_secret_here

# External services
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=noreply@code.fisamy.work
SMTP_PASSWORD=

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
