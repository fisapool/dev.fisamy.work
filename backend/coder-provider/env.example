# Coder Provider-Grade Environment Configuration
# Copy this file to .env and fill in your actual values

# Required: PostgreSQL password (generate a strong one)
CODER_PG_PASSWORD="$(openssl rand -base64 24 | tr -d '=+/')"

# Required: Your domain
CODER_ACCESS_URL="https://dev.fisamy.work"

# Optional: Resource limits for workspaces
CODER_MAX_WORKSPACE_CPUS=6
CODER_MAX_WORKSPACE_MEMORY=16Gi
CODER_MAX_WORKSPACE_DISK=100Gi
CODER_DEFAULT_WORKSPACE_IDLE_TIMEOUT=30m

# Optional: Security settings
CODER_SIGNING_KEY="$(openssl rand -base64 32)"

# Optional: Session settings
CODER_SESSION_DURATION="24h"

# Optional: Feature flags
CODER_TELEMETRY="false"
CODER_UPDATE_CHECK="false"

# Optional: Redis settings (if using Redis)
REDIS_PASSWORD="$(openssl rand -base64 16 | tr -d '=+/')"
