# Production Environment Variables for code.fisamy.work
# Copy to .env.local and fill in your actual values

# REQUIRED - Domain Configuration (Checklist #1)
VITE_DOMAIN_ROOT=code.fisamy.work
VITE_API_ENDPOINT=https://api.code.fisamy.work

# REQUIRED - Payment Provider (Checklist #10)
VITE_PAYMENT_PROVIDER=shopee
VITE_PAYMENT_PUBLIC_KEY=your_shopee_public_key_here
VITE_PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# REQUIRED - Checkout URLs (Checklist #10)
VITE_CHECKOUT_SOLO=https://checkout.shopee.my/plan/solo-monthly
VITE_CHECKOUT_PRO=https://checkout.shopee.my/plan/pro-monthly  
VITE_CHECKOUT_TEAM=https://checkout.shopee.my/plan/team-monthly

# Analytics & Monitoring (Checklist #6)
VITE_ANALYTICS_ENDPOINT=/api/analytics
VITE_ANALYTICS_ENABLED=true

# Support Configuration (Checklist #8, #11)
VITE_SUPPORT_EMAIL=support@code.fisamy.work
VITE_STATUS_PAGE_URL=https://status.code.fisamy.work

# Feature Flags
VITE_ADMIN_ENABLED=false
VITE_GPU_ENABLED=false
VITE_BETA_FEATURES=false

# Deployment Info (for debugging)
VITE_ENVIRONMENT=production
VITE_VERSION=1.0.0
VITE_BUILD_DATE=2024-01-01T00:00:00Z
VITE_COMMIT_HASH=abc123def456

# Optional - Development/Staging Overrides
# VITE_DEBUG=false
# VITE_LOG_LEVEL=error
