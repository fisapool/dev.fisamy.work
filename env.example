# VSCode Hosting Provider Configuration
# Copy this file to .env.local and fill in your actual values

# Frontend Configuration
VITE_APP_NAME="code.fisamy.work"
VITE_APP_VERSION="1.0.0"

# API Keys (for AI features in workspaces)
OPENAI_API_KEY="your-openai-api-key-here"
CODEIUM_API_KEY="your-codeium-api-key-here"

# Backend URLs
VITE_API_BASE_URL="https://dev.fisamy.work"
VITE_CODER_ACCESS_URL="https://dev.fisamy.work"

# Stripe Checkout URLs (replace with your actual checkout URLs)
VITE_CHECKOUT_SOLO="https://checkout.stripe.com/pay/cs_test_..."
VITE_CHECKOUT_PRO="https://checkout.stripe.com/pay/cs_test_..."
VITE_CHECKOUT_TEAM="https://checkout.stripe.com/pay/cs_test_..."

# Monitoring & Analytics
VITE_ENABLE_ANALYTICS="false"
VITE_ANALYTICS_ID=""

# Feature Flags
VITE_ENABLE_AI_FEATURES="true"
VITE_ENABLE_TEAM_FEATURES="true"
VITE_ENABLE_GPU_WORKSPACES="false"
