# Uptime Kuma Configuration
# Copy this file to /etc/fisamy/uptime.env and fill in your values

# Your Uptime Kuma instance URL
UPTIME_KUMA_URL=https://your-uptime-kuma.instance

# Your Uptime Kuma username
UPTIME_KUMA_USERNAME=your_username

# Your Uptime Kuma password
UPTIME_KUMA_PASSWORD=your_password

# Optional: Customize monitor intervals (in seconds)
# CODER_MONITOR_INTERVAL=60
# BFF_MONITOR_INTERVAL=60
# WILDCARD_MONITOR_INTERVAL=300
